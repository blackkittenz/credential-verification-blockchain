flowchart TD
    Start(["Start: VeriKredensial"]) --> Connect{"Metode Akses"}

    Connect -->|"Simulator"| LocalNode["Simulasi Hardhat: 10.000 ETH"]
    Connect -->|"MetaMask"| EIP1193["MetaMask: EIP-1193 Provider"]
    Connect -->|"Direct View"| DirectRPC["Direct RPC: rpc.prizftm.my.id"]

    LocalNode --> SelectRole["Pilih Identitas / Role"]
    EIP1193 --> SelectRole
    DirectRPC --> SelectRole

    SelectRole --> ChooseRoute{"Pilih Rute Layanan"}

    %% RUTE 1: PENERBITAN IJAZAH (/issuer)
    ChooseRoute -->|"/issuer"| Upload["Unggah Berkas PDF Ijazah"]
    Upload --> HashKeccak["Hash Keccak-256 Client"]
    HashKeccak --> HashNIM["Hash NIM Mahasiswa: Zero PII"]
    HashNIM --> CreateRecord["issueCredential On-Chain"]
    CreateRecord --> RoleOK{"Role Authorized?"}
    RoleOK -->|"Tidak"| RevertAuth["Revert: NotAuthorizedIssuer"]
    RoleOK -->|"Ya"| ExistCheck{"ID Terdaftar?"}
    ExistCheck -->|"Ya"| RevertDup["Revert: CredentialAlreadyExists"]
    ExistCheck -->|"Tidak"| Active(["Status: ACTIVE"])

    %% RUTE 2: VERIFIKASI PUBLIK (0 GAS)
    ChooseRoute -->|"verify"| FileOrHash["Input ID & Drag PDF"]
    FileOrHash --> HashClient["Hash Keccak-256 Lokal"]
    HashClient --> verifyRecord["verifyCredential View Call: 0 Gas"]
    verifyRecord --> Match{"Evaluasi Hash & State"}
    Match -->|"Hash Cocok & Active"| Certificate(["VALID: Ijazah Otentik Sah"])
    Match -->|"Hash Beda"| Mismatch["HASH_MISMATCH: Terindikasi Palsu"]
    Match -->|"ID Tidak Ada"| NotFound["NOT_FOUND: Belum Terdaftar"]
    Match -->|"Waktu Lewat"| Expired["EXPIRED: Masa Berlaku Habis"]
    Match -->|"Status Revoked"| RevokedState["REVOKED: Ijazah Dicabut"]

    %% RUTE 3: RALAT SILSILAH DOKUMEN (SUPERSEDE)
    ChooseRoute -->|"supersede"| SuperPanel["Panel Ralat Dokumen"]
    SuperPanel --> ComputeSuper["Input ID Lama & Hash PDF Baru"]
    ComputeSuper --> supersedeCall["supersedeCredential"]
    supersedeCall --> SuperOwner{"Penerbit Asli?"}
    SuperOwner -->|"Bukan"| RevertOwner["Revert: NotIssuingAuthority"]
    SuperOwner -->|"Ya"| SupersededDone(["Status Lama: SUPERSEDED"])
    SupersededDone --> LinkNew["Tautkan Pointer: supersededBy"]
    LinkNew --> Active

    %% RUTE 4: TATA KELOLA REKTORAT (ADMIN)
    ChooseRoute -->|"admin"| AdminPanel["Panel Tata Kelola Rektorat"]
    AdminPanel --> Action{"Aksi Rektorat"}
    Action -->|"Daftar Dekanat"| grantRole["registerIssuer"]
    Action -->|"Cabut Ijazah"| revokeAction["revokeCredential"]
    
    grantRole --> AdminCheck{"Super Admin?"}
    AdminCheck -->|"Bukan"| RevertAdmin["Revert: NotAdmin"]
    AdminCheck -->|"Ya"| Emitted(["Whitelist Dekanat Aktif"])

    revokeAction --> RevokeOwner{"Strict Ownership?"}
    RevokeOwner -->|"Bukan"| RevertRevoke["Revert: NotIssuingAuthority"]
    RevokeOwner -->|"Ya"| RevokedDone(["Status: REVOKED Permanen"])

    %% Konvergensi ke Record Active
    Active --> RecordActive["Record Kredensial On-Chain: ACTIVE"]

    %% Post-Active Lifecycle
    RecordActive -->|"Evaluasi Waktu"| ExpiryCheck{"block.timestamp > validUntil?"}
    ExpiryCheck -->|"Ya & validUntil > 0"| AutoDeny["Auto Status: EXPIRED"]
    ExpiryCheck -->|"validUntil == 0"| Lifetime["Berlaku Seumur Hidup"]
    RecordActive -->|"Sanksi Plagiarisme"| RevokedDone
    RecordActive -->|"Ralat Typo"| SupersededDone
